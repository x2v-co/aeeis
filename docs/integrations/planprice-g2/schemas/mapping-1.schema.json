{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.aeeis.dev/planprice/1/schemas/mapping-1.schema.json",
  "title": "mapping-1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "aeeis-model-mapping/1"
    },
    "mappingVersion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9._~-]{0,119}$"
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "offeringId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9._~-]{0,119}$"
          },
          "endpointRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "requestModel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "credentialRef": {
            "type": "string",
            "pattern": "^secret://[^\\s]+$"
          }
        },
        "required": [
          "offeringId",
          "endpointRef",
          "requestModel",
          "credentialRef"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "mappingVersion",
    "mappings"
  ]
}
