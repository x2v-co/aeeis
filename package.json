{
  "name": "@x2v/aeeis",
  "version": "0.1.0",
  "private": true,
  "description": "AEEIS: a user-owned, long-running RSI agent.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/ui/app.ts --bundle --format=esm --target=es2022 --outfile=dist/ui/app.js",
    "verify": "node scripts/verify.mjs",
    "test:serial": "vitest run --pool=forks --maxWorkers=1 --minWorkers=1 --no-file-parallelism",
    "dev": "npm run build && node --import ./scripts/load-local-env.mjs --import tsx src/server.ts",
    "demo:local": "node scripts/demo-local.mjs",
    "demo:full-local": "node scripts/demo-full-local.mjs",
    "smoke:local": "node scripts/smoke-local.mjs",
    "smoke:full-local": "node scripts/smoke-full-local.mjs",
    "smoke:local:restart": "node scripts/smoke-local-restart.mjs",
    "demo:model": "node scripts/fixture-model.mjs",
    "demo:evaluator": "node scripts/fixture-evaluator.mjs",
    "demo:agent": "node scripts/fixture-agent.mjs",
    "smoke:compose": "node scripts/smoke-compose.mjs",
    "smoke:monitoring": "node scripts/smoke-monitoring.mjs",
    "test:monitoring": "node scripts/test-monitoring.mjs",
    "smoke:toolkit": "npm run build && node scripts/smoke-toolkit.mjs",
    "smoke:planprice": "npm run build && node scripts/smoke-planprice.mjs",
    "smoke:planprice:v1": "npm run build && node scripts/smoke-planprice-v1.mjs",
    "g2:validate": "node scripts/validate-planprice-g2.mjs",
    "g3:preflight": "node scripts/preflight-planprice-g3.mjs",
    "backup:postgres": "node scripts/backup-postgres.mjs",
    "backup:verify": "node scripts/verify-backup.mjs",
    "backup:restore": "node scripts/restore-postgres.mjs",
    "recovery:postgres": "npm run build && node scripts/recovery-drill.mjs",
    "temporal:replay": "npm run build && node scripts/replay-temporal-history.mjs",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "worker": "node dist/temporal/worker.js",
    "test:runtime": "vitest run tests/runtime.test.ts tests/model-http.test.ts tests/http-runtime.test.ts tests/protocol-evolution.test.ts tests/integrations-brain.test.ts",
    "test:postgres": "node scripts/test-postgres.mjs",
    "sandbox:build": "node --import ./scripts/load-local-env.mjs --import tsx scripts/sandbox.ts build",
    "test:sandbox": "AEEIS_TEST_SANDBOX=1 vitest run tests/local-tools.test.ts --testTimeout=60000 --hookTimeout=30000",
    "sandbox:up": "node --import ./scripts/load-local-env.mjs --import tsx scripts/sandbox.ts up",
    "sandbox:doctor": "node --import ./scripts/load-local-env.mjs --import tsx scripts/sandbox.ts doctor",
    "sandbox:release": "node --import ./scripts/load-local-env.mjs --import tsx scripts/sandbox.ts release"
  },
  "devDependencies": {
    "@temporalio/testing": "^1.24.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "yaml": "2.8.1"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@temporalio/client": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "canonicalize": "^2.1.0",
    "dompurify": "^3.4.16",
    "fastify": "^5.12.5",
    "marked": "^18.0.14",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  }
}
