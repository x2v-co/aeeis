# AEEIS binds to loopback by default.
PORT=4323
AEEIS_DATA_DIR=data/runs

# Required for real model execution. Use an OpenAI-compatible /chat/completions base URL.
AEEIS_MODEL_BASE_URL=http://127.0.0.1:8080/v1
AEEIS_MODEL=fixture-or-your-model
AEEIS_MODEL_API_KEY=

# Optional dynamic model routing through planprice. Configure one HTTPS
# OpenAI-compatible endpoint and credential per provider slug.
AEEIS_PLANPRICE_URL=
AEEIS_MODEL_PROVIDER_ENDPOINTS={}
AEEIS_MODEL_PROVIDER_KEYS={}

# Optional governed capabilities and Personal Methods.
AEEIS_TOOLKIT_MANIFEST_URL=
AEEIS_TOOLKIT_INVOKE_URL=
AEEIS_TOOLKIT_RECONCILE_URL=
AEEIS_TOOLKIT_TOKEN=
AEEIS_OWNHOW_ENABLED=0
AEEIS_OWNHOW_BIN=ownhow
AEEIS_OWNHOW_STATE_DIR=

# Optional admitted external Agent Cards (JSON array). Each card must include
# endpoint/auth/protocol metadata; the Runtime still requires per-Run allowlists.
AEEIS_AGENT_CARDS=
AEEIS_AGENT_BEARER_TOKEN=

# Optional owned Knowledge Provider used by Runtime runs with knowledgeQuery.
AEEIS_KNOWLEDGE_URL=
AEEIS_KNOWLEDGE_TOKEN=

# Optional local API protection and Temporal activity protection.
AEEIS_ACCESS_TOKEN=
AEEIS_WORKER_TOKEN=

# local (default) or temporal
AEEIS_RUNNER=local
TEMPORAL_ADDRESS=127.0.0.1:7233
AEEIS_TASK_QUEUE=aeeis-agent
