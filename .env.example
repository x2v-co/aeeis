# AEEIS binds to loopback by default.
PORT=4323
AEEIS_HOST=127.0.0.1
# Set to production to enable startup checks for PostgreSQL, authentication,
# secure transports and Temporal deployment invariants.
AEEIS_ENV=development
# Declare a deployment using simulated dependencies. 0 does not certify real-model quality.
AEEIS_DEMO_MODE=0
AEEIS_DATA_DIR=data/runs
# Optional explicit path for durable Room membership state in local mode
# AEEIS_ROOM_MEMBERSHIP_PATH=data/runs/room-memberships.json
AEEIS_BACKUP_DIR=backups
# Any AEEIS_*, TEMPORAL_* or DATABASE_URL setting may also be supplied as
# <NAME>_FILE=/run/secrets/name. A direct value and its *_FILE form cannot be
# configured together; the file must contain a non-empty value.
# Recovery rehearsal only: explicit administrative URL used to create/drop an
# isolated temporary database. Never point this at a production application DB.
AEEIS_RESTORE_ADMIN_DATABASE_URL=
AEEIS_RESTORE_KEEP_DATABASE=0
# Optional local durable ledger for domain Task dispatch reservations.
# With DATABASE_URL, PostgreSQL is used automatically instead.
AEEIS_TASK_DISPATCH_PATH=
# Optional durable one-shot Reminder store in local mode. PostgreSQL is used
# automatically when DATABASE_URL is configured.
AEEIS_REMINDER_PATH=
AEEIS_REMINDER_INTERVAL_MS=1000
AEEIS_REMINDER_BATCH=20
AEEIS_REMINDER_LEASE_MS=30000
AEEIS_REMINDER_RETRY_DELAY_MS=30000

# Optional durable budget shared by all billable model roles in a tenant.
# JSON array; the most specific owner/tenant rule wins. Example:
# [{"tenantId":"team-a","window":"day","budget":{"calls":100,"tokens":200000,"moneyUsd":20}}]
# Calls are reserved before dispatch; tokens/USD settle from provider usage.
AEEIS_GLOBAL_BUDGETS=
AEEIS_GLOBAL_BUDGET_PATH=

# Required for real model execution. Use an OpenAI-compatible /chat/completions base URL.
# For paid Toolkit credits, set AEEIS_AGENTPAY_MCP_URL/TOKEN/MAX_CREDITS instead;
# the stable purchase id is derived from each durable model-call idempotency key.
AEEIS_AGENTPAY_MCP_URL=
AEEIS_AGENTPAY_TOKEN=
AEEIS_AGENTPAY_MAX_CREDITS=1
AEEIS_MODEL_BASE_URL=http://127.0.0.1:8080/v1
AEEIS_MODEL=fixture-or-your-model
AEEIS_MODEL_API_KEY=
# Optional authenticated provider health endpoint. When set, /readyz probes it.
AEEIS_MODEL_HEALTH_URL=
# Development-only escape hatch for an explicitly trusted internal HTTP service
# such as the Docker Compose fixture model. Keep disabled for real providers.
AEEIS_MODEL_ALLOW_INSECURE_HTTP=0

# Development-only local fixture model (run `npm run demo:model` in another terminal).
# It demonstrates the protocol and state machine; it is not a real model.
# AEEIS_DEMO_MODE=1
# AEEIS_MODEL_BASE_URL=http://127.0.0.1:4399/v1
# AEEIS_MODEL=aeeis-fixture/1

# Optional dynamic model routing through planprice. Configure one HTTPS
# OpenAI-compatible endpoint and credential per provider slug.
AEEIS_PLANPRICE_URL=
# Optional read-only GET probe on the same Planprice origin. It is used for
# dependency diagnostics only and never invokes a model or refreshes pricing.
AEEIS_PLANPRICE_HEALTH_URL=
# Development-only escape hatch for an internal HTTP Planprice fixture. Never set in production.
AEEIS_PLANPRICE_ALLOW_INSECURE_HTTP=0
# Cache successful Planprice reads for this many milliseconds (0 disables cache).
AEEIS_PLANPRICE_CACHE_TTL_MS=30000
AEEIS_MODEL_PROVIDER_ENDPOINTS={}
AEEIS_MODEL_PROVIDER_KEYS={}
# Explicit data policy for catalog providers/models. Private runs require a
# matching true entry; omitted entries fail closed. Example: {"provider-a":true}
AEEIS_MODEL_PRIVATE_DATA_ALLOWED={}
# Optional provider health URLs, keyed by provider slug or model. When set,
# /readyz probes the provider selected for an internal Agent run.
AEEIS_MODEL_PROVIDER_HEALTH_URLS={}
# Development-only escape hatch for HTTP provider endpoints returned by a local Planprice fixture.
AEEIS_MODEL_PROVIDER_ALLOW_INSECURE_HTTP=0

# Optional isolated RSI evaluator. It receives one bounded test case at a time
# and returns rsi-evaluation-observation/1; it has no AEEIS write access.
AEEIS_RSI_EVALUATOR_URL=
AEEIS_RSI_EVALUATOR_TOKEN=
# Optional same-origin read-only GET endpoint for evaluator readiness.
AEEIS_RSI_EVALUATOR_HEALTH_URL=
# Development-only escape hatch for an explicitly trusted internal HTTP
# evaluator such as the Docker Compose fixture. Keep disabled for production.
AEEIS_RSI_EVALUATOR_ALLOW_INSECURE_HTTP=0

# Optional channel projection sink (Feishu/Hermes adapters can implement this
# contract). Canonical Debate/Competition state remains in AEEIS.
AEEIS_PROJECTION_SINK_URL=
AEEIS_PROJECTION_SINK_TOKEN=
# Optional same-origin read-only GET endpoint for projection sink readiness.
AEEIS_PROJECTION_SINK_HEALTH_URL=
# Optional Feishu incoming webhook projection. Private data is always refused;
# confidential data requires explicit opt-in (1).
AEEIS_FEISHU_APP_ID=
AEEIS_FEISHU_APP_SECRET=
AEEIS_FEISHU_API_BASE_URL=https://open.feishu.cn
# Optional comma-separated chat_id allowlist for application projections.
AEEIS_FEISHU_ALLOWED_CHAT_IDS=
# Optional Feishu/Hermes inbound Debate bridge. The webhook is enabled only
# when the event encrypt key is set. Routes and sender mappings are explicit
# JSON so a chat or identity cannot implicitly acquire Debate access.
AEEIS_FEISHU_EVENT_ENCRYPT_KEY=
AEEIS_FEISHU_VERIFICATION_TOKEN=
# Example: [{"chatId":"oc_release","debateId":"debate_release","owner":"owner","tenantId":"local"}]
AEEIS_FEISHU_DEBATE_ROUTES=
# Example: {"ou_sender_open_id":"agent.human"}
AEEIS_FEISHU_SENDER_AGENTS=
# Optional organization-owned Channel Identity resolver. When configured it
# takes precedence over the static sender map above. Production deployments
# must use the HTTPS URL; the JSON path is for local development only.
AEEIS_CHANNEL_IDENTITY_URL=
AEEIS_CHANNEL_IDENTITY_TOKEN=
AEEIS_CHANNEL_IDENTITY_TIMEOUT_MS=5000
AEEIS_CHANNEL_IDENTITY_ALLOW_INSECURE_HTTP=0
AEEIS_CHANNEL_IDENTITY_PATH=
AEEIS_FEISHU_WEBHOOK_URL=
AEEIS_FEISHU_ALLOW_CONFIDENTIAL=0
# Optional local Hermes CLI projection. The CLI reuses Hermes' configured
# platform credentials; destination uses Hermes' `platform:channel[:thread]`
# format, e.g. `feishu:oc_release`. Private data is always refused.
AEEIS_HERMES_CLI_PATH=
AEEIS_HERMES_CLI_TIMEOUT_MS=30000
AEEIS_HERMES_ALLOW_CONFIDENTIAL=0
# Optional direct Hermes bridge. Hermes signs the exact request body with
# HMAC-SHA256 over `${timestamp}\n${nonce}\n${rawBody}` and sends the key id.
# Example: {"hermes-local":"replace-with-at-least-16-chars"}
AEEIS_HERMES_SIGNING_KEYS=
# Example: [{"roomId":"release-room","debateId":"debate_release","owner":"owner","tenantId":"local"}]
AEEIS_HERMES_DEBATE_ROUTES=
# Example: {"hermes-user-1":"agent.human"}
AEEIS_HERMES_SENDER_AGENTS=

# Durable Competition/Debate trigger policies. PostgreSQL deployments use
# the shared database automatically; local deployments use this directory.
AEEIS_COLLABORATION_TRIGGERS_PATH=
# Shared Session canonical events. PostgreSQL deployments use the shared
# database; local deployments use this append-only JSON store.
AEEIS_SESSION_EVENTS_PATH=

# Optional governed capabilities and Personal Methods.
# toolkit_new Registry mode (preferred): the URL should end in /api/v1/registry.
AEEIS_TOOLKIT_MCP_URL=
AEEIS_TOOLKIT_DEFAULT_VERSION=rolling
AEEIS_TOOLKIT_REGISTRY_URL=
AEEIS_TOOLKIT_MANIFEST_URL=
AEEIS_TOOLKIT_INVOKE_URL=
# Optional machine-to-machine endpoint for unknown toolkit Registry calls.
# It must accept tool-reconcile/1 and return tool-result/1; the Registry's
# session-only user receipt route is intentionally not used by AEEIS.
AEEIS_TOOLKIT_RECONCILE_URL=
AEEIS_TOOLKIT_TOKEN=
# Registry signatures are optional in development and required in production.
AEEIS_TOOLKIT_VERIFY_SIGNATURES=0
AEEIS_TOOLKIT_ROOT_PUBLIC_JWK=
# Optional operator-pinned toolkit.fun tools that are not published in the
# signed Registry yet. Each entry must include id, version and same-origin
# endpoint; these remain subject to Run allowlists and budgets.
AEEIS_TOOLKIT_PINNED_TOOLS=
AEEIS_OWNHOW_ENABLED=0
AEEIS_OWNHOW_BIN=ownhow
AEEIS_OWNHOW_STATE_DIR=
# Required when OwnHow is enabled; startup rejects an enabled governance
# adapter without a concrete runtime.
AEEIS_OWNHOW_RUNTIME=

# Optional admitted external Agent Cards (JSON array). Each card must include
# endpoint/auth/protocol metadata; the Runtime still requires per-Run allowlists.
AEEIS_AGENT_CARDS=
# With DATABASE_URL set, the Agent Registry uses PostgreSQL automatically.
# Set this path to force the local JSON registry instead.
AEEIS_AGENT_REGISTRY_PATH=
AEEIS_AGENT_BEARER_TOKEN=
AEEIS_AGENT_SIGNING_KEYS=
# Optional exact host allowlist for Agent Card discovery and delegation
# endpoints. If set, every endpoint hostname must match one comma-separated
# entry; ports do not widen the match.
AEEIS_AGENT_ALLOWED_HOSTS=
# Machine-to-machine OAuth, default client_secret_basic; authMethod may be client_secret_post.
# JSON object keyed by Agent ID: {"agent.id":{"tokenUrl":"https://...","clientId":"...","clientSecret":"...","scopes":["..."]}}
AEEIS_AGENT_OAUTH_CONFIG=

# Optional internal competition model pool. The JSON keys are participant IDs;
# each value contains {"baseUrl","model","provider"? ,"apiKey"?}.
# When AEEIS_PLANPRICE_URL is configured, static participant/evaluator endpoints
# may be omitted and the shared Planprice resolver supplies the logical roles.
AEEIS_COMPETITION_AGENT_MODELS=
AEEIS_COMPETITION_EVALUATOR_AGENT_ID=agent.evaluator
AEEIS_COMPETITION_EVALUATOR_BASE_URL=
AEEIS_COMPETITION_EVALUATOR_MODEL=
# Optional USD prices for the independent evaluator; per-agent prices use the same object
# in AEEIS_COMPETITION_AGENT_MODELS under each agent's "prices" field.
# Example: {"inputPricePerMillion":1,"outputPricePerMillion":2,"currency":"USD"}
AEEIS_COMPETITION_EVALUATOR_PRICES=
AEEIS_COMPETITION_EVALUATOR_API_KEY=
AEEIS_DEBATE_MODERATOR_AGENT_ID=
AEEIS_DEBATE_ADJUDICATOR_AGENT_ID=
# In development, static competition endpoints may use HTTP only when the
# explicit AEEIS_MODEL_ALLOW_INSECURE_HTTP=1 switch is also enabled.

# Optional owned Knowledge Provider used by Runtime runs with knowledgeQuery.
AEEIS_KNOWLEDGE_URL=
# Optional read-only GET health endpoint on the same origin; no search or billing.
AEEIS_KNOWLEDGE_HEALTH_URL=
AEEIS_KNOWLEDGE_TOKEN=
AEEIS_KNOWLEDGE_FILE=
# Optional PostgreSQL Knowledge Provider. Defaults to DATABASE_URL when set
# and no HTTP/file provider is configured.
AEEIS_KNOWLEDGE_DATABASE_URL=
# Optional OpenAI-compatible embedding index for PostgreSQL Knowledge.
# Enabling this requires the PostgreSQL pgvector extension.
AEEIS_KNOWLEDGE_EMBEDDING_URL=
AEEIS_KNOWLEDGE_EMBEDDING_MODEL=text-embedding-3-small
AEEIS_KNOWLEDGE_EMBEDDING_API_KEY=
AEEIS_KNOWLEDGE_EMBEDDING_DIMENSIONS=1536
# Optional durable embedding reindex operator pump. 0 disables the in-process
# pump; operators can use POST /api/knowledge/embedding-reindex and /run.
AEEIS_KNOWLEDGE_REINDEX_INTERVAL_MS=0
# Optional PostgreSQL Brain semantic side index. Brain JSONB state remains
# canonical; pgvector is rebuildable and falls back to lexical retrieval.
# Requires DATABASE_URL and the PostgreSQL pgvector extension.
AEEIS_BRAIN_EMBEDDING_URL=
# Optional same-origin GET health URL; probes never generate embeddings.
AEEIS_BRAIN_EMBEDDING_HEALTH_URL=
AEEIS_BRAIN_EMBEDDING_MODEL=text-embedding-3-small
AEEIS_BRAIN_EMBEDDING_API_KEY=
AEEIS_BRAIN_EMBEDDING_DIMENSIONS=1536
# Optional HTTP Project Source Connector. It receives project-source-search/1
# and must return project-source-results/1; non-loopback URLs must use HTTPS.
AEEIS_PROJECT_SOURCES_URL=
# Optional read-only GET health endpoint on the same origin.
AEEIS_PROJECT_SOURCES_HEALTH_URL=
AEEIS_PROJECT_SOURCES_TOKEN=
# Optional JSON array produced by a project connector/import job. Records can
# be document, task, message, code or other, and may carry tenantId.
AEEIS_PROJECT_SOURCES_FILE=
# Optional service-side Git project sources. JSON array; each entry has
# {"id","root","tenantId","paths":["docs"],"classification":"internal"}.
# Only committed text in these paths is read; secrets and binary files are excluded.
AEEIS_PROJECT_GIT=
# Optional direct Linear GraphQL connectors (JSON array). Each entry has
# {"id","apiKey","tenantId"} and may set endpoint, teamId and classification.
# The API key is installation configuration; it is never accepted in a Run request.
AEEIS_LINEAR_PROJECT_SOURCES=
# JSON array of Jira REST source configs. Each entry uses bearer auth by default;
# set auth=basic plus username for Jira Cloud email + API token installations.
AEEIS_JIRA_PROJECT_SOURCES=
# Optional path for durable incremental project-source cursors in local mode.
# With DATABASE_URL, PostgreSQL is used automatically instead.
AEEIS_PROJECT_SOURCE_CHECKPOINT_PATH=

# Optional local API protection and Temporal activity protection.
AEEIS_ACCESS_TOKEN=
AEEIS_WORKER_TOKEN=
# Comma-separated extra Host values for /internal/ Worker requests only.
# Loopback hosts remain trusted. Worker token and origin checks still apply.
AEEIS_TRUSTED_HOSTS=
# Public host names accepted behind a reverse proxy, comma-separated. Keep
# empty for local loopback-only operation; requests with other Host values are
# rejected. Do not include URL schemes or paths.
AEEIS_PUBLIC_HOSTS=
# Explicit browser origins allowed for CORS-style requests, comma-separated
# (for example https://app.example.com). Same-origin loopback requests remain
# available in local mode.
AEEIS_TRUSTED_ORIGINS=

# Optional OIDC resource-server authentication. Configure all three together;
# the JWT must carry a tenant claim and a roles claim containing owner,
# operator, or agent. OIDC cannot be combined with the local token maps above.
AEEIS_OIDC_ISSUER=
AEEIS_OIDC_AUDIENCE=
AEEIS_OIDC_JWKS_URL=
AEEIS_OIDC_TENANT_CLAIM=tenant_id
AEEIS_OIDC_ROLES_CLAIM=roles

# Optional organization principal directory used when inviting Room members.
# Authentication still comes from OIDC/static tokens; this directory verifies
# that the target principal exists, belongs to the same tenant, and is active.
# Configure exactly one of URL or PATH. URL responses are queried with
# principalId and tenantId and must return { principalId, tenantId, status }.
AEEIS_PRINCIPAL_DIRECTORY_URL=
AEEIS_PRINCIPAL_DIRECTORY_TOKEN=
AEEIS_PRINCIPAL_DIRECTORY_PATH=
AEEIS_PRINCIPAL_DIRECTORY_TIMEOUT_MS=5000
AEEIS_PRINCIPAL_DIRECTORY_CACHE_TTL_MS=10000
AEEIS_PRINCIPAL_DIRECTORY_CACHE_MAX_ENTRIES=10000
AEEIS_PRINCIPAL_DIRECTORY_ALLOW_INSECURE_HTTP=0

# local (default) or temporal
AEEIS_RUNNER=local
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
AEEIS_TASK_QUEUE=aeeis-agent
AEEIS_BUILD_ID=aeeis-worker-dev
AEEIS_TEMPORAL_USE_VERSIONING=0
# Versioned production Workers must choose an explicit rollout operation.
# `bootstrap`/`new-default` starts a new compatibility set, `compatible`
# attaches to AEEIS_TEMPORAL_COMPATIBLE_WITH, and `promote` promotes this set.
AEEIS_TEMPORAL_BUILD_ID_ROLLOUT=none
AEEIS_TEMPORAL_COMPATIBLE_WITH=
AEEIS_INTERNAL_URL=http://127.0.0.1:4323
# API-side Worker readiness probe. In production this must be an HTTPS URL;
# development may point at the local Worker /readyz endpoint.
AEEIS_TEMPORAL_WORKER_HEALTH_URL=http://127.0.0.1:4324/readyz
AEEIS_TEMPORAL_WORKER_HEALTH_ALLOW_INSECURE_HTTP=0
# Development-only escape hatch for a Worker calling an internal HTTP API
# such as the Docker Compose service name. Production must use HTTPS.
AEEIS_WORKER_ALLOW_INSECURE_HTTP=0
AEEIS_WORKER_HEALTH_HOST=127.0.0.1
AEEIS_WORKER_HEALTH_PORT=4324
AEEIS_WORKER_SHUTDOWN_GRACE_MS=30000
AEEIS_WORKER_SHUTDOWN_FORCE_MS=60000
# Maximum concurrent Run event SSE streams per API process.
AEEIS_MAX_SSE_CONNECTIONS=100
AEEIS_RSI_PROPOSAL_INTERVAL_MS=1000
AEEIS_RSI_PROPOSAL_BATCH=100
AEEIS_RSI_LOW_CONFIDENCE_THRESHOLD=0.5
AEEIS_RSI_PROPOSAL_CLAIM_LEASE_MS=30000
# Optional in File mode; claims default to $AEEIS_DATA_DIR/rsi-proposal-claims.json
# AEEIS_RSI_PROPOSAL_CLAIMS_PATH=data/runs/rsi-proposal-claims.json
# Durable replay cursor for RSI and collaboration pumps; PostgreSQL stores it
# in the database. File mode uses the path below by default.
# AEEIS_RUN_SCAN_CURSOR_PATH=data/runs/run-scan-cursors.json
# Disabled by default. When enabled, unresolved failure signals may spend one
# separately governed model call to synthesize a concrete proposal. Unknown
# provider outcomes require the explicit Run reconciliation endpoint.
# A fixed AEEIS_MODEL_BASE_URL + AEEIS_MODEL or AEEIS_PLANPRICE_URL is required.
# Production also requires an independent AEEIS_RSI_EVALUATOR_URL.
AEEIS_RSI_PROPOSAL_SYNTHESIS_ENABLED=0
AEEIS_RSI_PROPOSAL_SYNTHESIS_PRIVACY=public,internal
AEEIS_RSI_PROPOSAL_SYNTHESIS_MAX_CALLS=1
AEEIS_RSI_PROPOSAL_SYNTHESIS_MAX_TOKENS=16000
# Optional USD prices for the configured fixed model when a global budget
# includes moneyUsd. Catalog routing must use per-model Planprice prices.
# AEEIS_RSI_PROPOSAL_SYNTHESIS_PRICES={"inputPricePerMillion":1,"outputPricePerMillion":2,"currency":"USD"}
# Internal-test RSI automation. Keep the evaluation suite operator-owned and
# versioned; candidates are never allowed to create their own test cases.
# Production should leave this disabled until an independent suite is supplied.
AEEIS_RSI_AUTOMATION_ENABLED=0
AEEIS_RSI_AUTO_APPROVE_LOW_RISK=0
AEEIS_RSI_AUTO_ROLLOUT=1
AEEIS_RSI_AUTO_ACTIVATE=0
AEEIS_RSI_AUTOMATION_INTERVAL_MS=30000
AEEIS_RSI_AUTOMATION_BATCH=10
AEEIS_RSI_AUTOMATION_MINIMUM_SCORE=0.7
AEEIS_RSI_EVALUATION_SUITE_VERSION=internal-v1
# AEEIS_RSI_EVALUATION_SUITE={"replay":[{"id":"...","input":{}}],"holdout":[...],"safety":[...],"shadow":[...]}
