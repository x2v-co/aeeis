# /etc/systemd/system/aeeis-health@.service  (+ .timer, every 5 min)
# Fails (-> aeeis-notify@) when API /readyz or Worker /readyz is not ready.
[Unit]
Description=AEEIS stack readiness probe (%i)
OnFailure=aeeis-notify@%i.service

[Service]
Type=oneshot
Environment=AEEIS_DEPLOY_DIR=/opt/aeeis/deploy/stack
EnvironmentFile=-/etc/aeeis/%i.env
ExecStart=/bin/bash -ec 'cd "$${AEEIS_DEPLOY_DIR}"; exec ./bin/health.sh'
TimeoutStartSec=60
