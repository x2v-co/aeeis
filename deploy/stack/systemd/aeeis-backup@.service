# /etc/systemd/system/aeeis-backup@.service
[Unit]
Description=AEEIS stack backup (%i)
Requires=docker.service
After=docker.service
OnFailure=aeeis-notify@%i.service

[Service]
Type=oneshot
Environment=AEEIS_DEPLOY_DIR=/opt/aeeis/deploy/stack
EnvironmentFile=-/etc/aeeis/%i.env
ExecStart=/bin/bash -ec 'cd "$${AEEIS_DEPLOY_DIR}"; exec ./bin/backup.sh'
TimeoutStartSec=3600
