# AEEIS single-host stack configuration. Copy to stack.env, chmod 600.
# Never commit stack.env. Generate secrets with: openssl rand -hex 32
# This file is used for compose interpolation, as the API env_file, AND is
# sourced by bash (bin/*.sh, systemd). Keep values shell-compatible: wrap JSON
# or anything with spaces in single quotes, e.g. X='{"a":"b"}'.

# --- Identity -------------------------------------------------------------
# Compose project name and Build ID prefix. One of: aeeis-cn | aeeis-sg
AEEIS_STACK=aeeis-cn
# Temporal task queue AND Worker Deployment name (keep equal to AEEIS_STACK).
AEEIS_TASK_QUEUE=aeeis-cn
TEMPORAL_NAMESPACE=aeeis
TEMPORAL_NAMESPACE_RETENTION=720h

# --- Network (tailnet only) ------------------------------------------------
# Host tailnet IP the API binds to (kk-cn: 100.110.2.20). Never 0.0.0.0.
AEEIS_BIND_IP=100.110.2.20
AEEIS_API_PORT=4323
# Host names accepted in the Host header (tailnet IP, MagicDNS short and FQDN).
AEEIS_PUBLIC_HOSTS=100.110.2.20,kk-cn,kk-qdta5hvfwfmrphrntffm.tailc7b6c3.ts.net
# Browser origins for the workbench, e.g. the tailscale serve HTTPS name.
AEEIS_TRUSTED_ORIGINS=
# Same-host loopback listener (Toolkit CN staging on kk-cn uses it).
AEEIS_LOOPBACK_API_PORT=4323
# Temporal gRPC is intentionally not published (see README "Remote Temporal").

# --- Secrets ----------------------------------------------------------------
AEEIS_POSTGRES_PASSWORD=change-me
TEMPORAL_POSTGRES_PASSWORD=change-me
# Worker -> API internal token (>= 16 chars).
AEEIS_WORKER_TOKEN=change-me-worker-token
# Bearer token for API clients (Toolkit, operators, smoke test).
AEEIS_ACCESS_TOKEN=change-me-access-token

# --- Model (required for real traffic) -------------------------------------
# OpenAI-compatible endpoint. HTTPS required (loopback excepted).
AEEIS_MODEL_BASE_URL=https://api.example.com/v1
AEEIS_MODEL=model-name
# Either the direct value OR the file variant - never both (even empty).
# File variant: put the key in ./secrets/model-key (chown 1000:1000, chmod 400).
#AEEIS_MODEL_API_KEY=
AEEIS_MODEL_API_KEY_FILE=/run/aeeis-secrets/model-key
AEEIS_MODEL_TIMEOUT_MS=180000
# Planprice catalog routing instead of a fixed model: see ../../.env.example.

# --- Projection (reminder / notification delivery) ---------------------------
# Generic HTTPS sink (aeeis-projection-event/1). Leave empty until a sink exists;
# reminders then stay in the durable outbox.
AEEIS_PROJECTION_SINK_URL=
AEEIS_PROJECTION_SINK_TOKEN=
AEEIS_PROJECTION_SINK_HEALTH_URL=

# --- Backups (bin/backup.sh) ------------------------------------------------
AEEIS_BACKUP_DIR=/var/backups/aeeis
AEEIS_BACKUP_KEEP_DAYS=14
# full = stop worker/api/temporal during the dump (consistent set, ~1-2 min
# downtime); none = online, per-database consistency only.
AEEIS_BACKUP_QUIESCE=full
# Off-host copy, run as: bash -c "$AEEIS_BACKUP_UPLOAD_CMD" upload <dir>
#   SG: rclone copy "$1" r2-aeeis:aeeis-backups/aeeis-sg/$(basename "$1")
#   CN: copy to CN-only storage (COS / second disk). CN data must not leave CN.
AEEIS_BACKUP_UPLOAD_CMD=

# --- Image / Temporal versions (normally leave as is) -------------------------
# AEEIS_TEMPORAL_IMAGE=temporalio/auto-setup:1.29.7
# AEEIS_POSTGRES_IMAGE=postgres:17-alpine
# AEEIS_NETNS_IMAGE=alpine:3.20
# Extra docker build flags, e.g. --network host or a CN npm mirror build-arg.
# AEEIS_DOCKER_BUILD_ARGS=
