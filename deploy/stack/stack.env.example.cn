# CN production template for kk-cn; provider: ARK or another approved mainland provider.
# Copy this template (or stack.env.example.sg / .cn) to stack.env; chmod 600.
# Placeholders only: replace every REPLACE_WITH_* value before deployment.
# Compose and bash source this file: single-quote JSON and values with spaces.
# Select it explicitly: ./bin/deploy.sh --env-file ./stack.env
# For direct Compose, this path is relative to deploy/stack/compose.yml.
STACK_ENV_FILE=./stack.env

AEEIS_STACK=aeeis-cn-prod
# Preserve the inventoried queue; the existing CN queue is aeeis-agent.
AEEIS_TASK_QUEUE=aeeis-agent
TEMPORAL_NAMESPACE=REPLACE_WITH_EXISTING_TEMPORAL_NAMESPACE
TEMPORAL_NAMESPACE_RETENTION=720h
# Must differ from the legacy Compose project; SG operators set its actual name.
AEEIS_LEGACY_STACK=aeeis-cn
# Optional registry prefix, no trailing slash; image pins are repository:tag.
#AEEIS_IMAGE_REGISTRY=ccr.ccs.tencentyun.com/x2v-co
# Optional pull mirror (best effort only; upstream is the final fallback).
#AEEIS_IMAGE_MIRROR=m.daocloud.io
AEEIS_ENV=production
AEEIS_TEMPORAL_USE_VERSIONING=1
AEEIS_TRUSTED_INTERNAL_HOSTS=api,worker

# Preserve the current namespace and task queue; do not assume a new region name.
# Tailnet IPv4, public Host headers and browser HTTPS origins.
AEEIS_BIND_IP=REPLACE_WITH_HOST_TAILNET_IPV4
AEEIS_API_PORT=4323
AEEIS_LOOPBACK_API_PORT=4323
AEEIS_PUBLIC_HOSTS=REPLACE_WITH_TAILNET_IP_AND_MAGICDNS_NAMES
AEEIS_TRUSTED_ORIGINS=REPLACE_WITH_WORKBENCH_HTTPS_ORIGIN
# Request Host allowlist for /internal/ (separate from the HTTP transport list).
# Loopback is implicit with this stack's shared network namespace.
AEEIS_TRUSTED_HOSTS=

# Preserve the existing caller and Worker tokens during migration.
# On restored PG volumes preserve the current database passwords too.
AEEIS_POSTGRES_PASSWORD=REPLACE_WITH_EXISTING_OR_NEW_AEEIS_DB_PASSWORD
TEMPORAL_POSTGRES_PASSWORD=REPLACE_WITH_EXISTING_OR_NEW_TEMPORAL_DB_PASSWORD
AEEIS_ACCESS_TOKEN=REPLACE_WITH_EXISTING_ACCESS_TOKEN
AEEIS_WORKER_TOKEN=REPLACE_WITH_EXISTING_WORKER_TOKEN

# Real OpenAI-compatible provider (e.g. OpenAI in SG or ARK in CN).
# Use the provider's HTTPS /v1-compatible base and actual model/endpoint ID.
AEEIS_MODEL_BASE_URL=https://REPLACE_WITH_PROVIDER_HOST/v1
AEEIS_MODEL=REPLACE_WITH_PROVIDER_MODEL_OR_ENDPOINT_ID
AEEIS_MODEL_API_KEY=REPLACE_WITH_PROVIDER_API_KEY
AEEIS_MODEL_TIMEOUT_MS=180000
# Optional provider-specific health URL; do not assume /health exists.
#AEEIS_MODEL_HEALTH_URL=https://REPLACE_WITH_PROVIDER_HOST/REPLACE_WITH_HEALTH_PATH
# File secret alternative: DELETE AEEIS_MODEL_API_KEY above, then uncomment.
# ./secrets/model-key must be owned by uid 1000 and mode 0400.
#AEEIS_MODEL_API_KEY_FILE=/run/aeeis-secrets/model-key

# Leave empty until a real HTTPS projection sink exists; reminders stay in outbox.
AEEIS_PROJECTION_SINK_URL=
AEEIS_PROJECTION_SINK_TOKEN=
AEEIS_PROJECTION_SINK_HEALTH_URL=

# Online backups: consistent snapshot per DB, taken at different instants.
# API/Worker/Temporal remain running; all 3 DBs are published atomically.
AEEIS_BACKUP_DIR=REPLACE_WITH_REGION_LOCAL_BACKUP_DIRECTORY
AEEIS_BACKUP_KEEP_DAYS=14
AEEIS_BACKUP_UPLOAD_CMD=
# Backup/health failures: optional webhook receiving JSON {"text":"..."}.
# Empty means journal only; notification delivery failures never fail hard.
AEEIS_NOTIFY_WEBHOOK=
# Optional Telegram target (messages tagged [aeeis]); both required.
AEEIS_NOTIFY_TG_BOT_TOKEN=
AEEIS_NOTIFY_TG_CHAT_ID=
# Optional notify proxy; default reads /etc/notify-failure/proxy if present.
AEEIS_NOTIFY_PROXY=

# Optional volume names: foreign Compose labels or legacy mounts are rejected.
# Defaults: <project>-postgres, <project>-temporal-postgres, <project>-data.
# Restore into fresh volumes; see the production migration runbook.
#AEEIS_POSTGRES_VOLUME=REPLACE_WITH_EXISTING_AEEIS_PG_VOLUME
#AEEIS_TEMPORAL_POSTGRES_VOLUME=REPLACE_WITH_EXISTING_TEMPORAL_PG_VOLUME
#AEEIS_DATA_VOLUME=REPLACE_WITH_EXISTING_AEEIS_DATA_VOLUME
# Image pins may be overridden after rehearsing schema compatibility.
#AEEIS_TEMPORAL_IMAGE=temporalio/auto-setup:1.29.7
#AEEIS_POSTGRES_IMAGE=postgres:17-alpine
#AEEIS_NETNS_IMAGE=alpine:3.20
#AEEIS_DOCKER_BUILD_ARGS=
# Keep backups in CN-approved storage; do not copy CN data overseas.
